# Homeserver origin config (Windows 10 + Cloudflare Tunnel).
# Runs locally on 127.0.0.1:8080 — no inbound exposure; cloudflared is the
# only client. Serves mirrored build output only, never the git clones.
#
# cloudflared forwards the original Host header, so Caddy routes on it.

# Portfolio (this repo — the Ulil Albab profile site). Adjust hostname
# if the domain differs.
ulilhibi.my.id:8080 {
	bind 127.0.0.1
	root * C:/srv/sites/hibi
	encode gzip

	# SPA history fallback: unknown paths → index.html, assets served as-is.
	try_files {path} /index.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}

# Projects hub: one subdomain + path routing (/furuhibi, /nyaahibiv2, ...).
# Landing page (dist-hub) sits at the root; each site is a folder under
# C:/srv/sites/projects. project.nyaahibi.web.id is the canonical URL in
# code (PROJECTS_BASE, og:url, registry links).
# try_files also tries "{path}.html" (legacy box files like dsp.html) and
# "{path}/index.html" (the emitted extensionless routes /furuhibi/preset,
# /furuhibi/download) so no .html ever appears in a link.
project.nyaahibi.web.id:8080 {
	bind 127.0.0.1
	root * C:/srv/sites/projects
	encode gzip
	try_files {path} {path}.html {path}/index.html /index.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}

# Main site (apex): the explanatory landing (main.html) serves the root;
# hub deep links (/dash, /<slug>, /furuhibi/...) still resolve from the
# same content root, so every shared URL works on both hostnames.
nyaahibi.web.id:8080 {
	bind 127.0.0.1
	root * C:/srv/sites/projects
	encode gzip

	# Exact root → main.html; unknown paths fall back to it as well.
	# "{path}.html" and "{path}/index.html" keep the extensionless routes
	# working here too.
	@root path /
	rewrite @root /main.html
	try_files {path} {path}.html {path}/index.html /main.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}
